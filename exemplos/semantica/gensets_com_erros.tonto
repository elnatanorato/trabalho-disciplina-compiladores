package ErrosSemanticos

kind Pessoa
phase Crianca specializes Pessoa
phase Adulto specializes Pessoa

// Phase pattern: falta disjoint. complete continua opcional.
genset Fases {
    general Pessoa
    specifics Crianca, Adulto
}

kind Veiculo
subkind Carro specializes Veiculo
subkind Moto specializes Veiculo

// Subkind pattern: falta disjoint, conforme o exemplo canônico da tarefa.
complete genset Veiculos {
    general Veiculo
    specifics Carro, Moto
}

role Aluno specializes Pessoa
role Professor specializes Pessoa

// Role pattern: o PDF orienta não aplicar disjoint aos roles.
disjoint genset Papeis {
    general Pessoa
    specifics Aluno, Professor
}
